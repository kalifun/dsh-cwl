    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "files": [
    "index.js",
    "lib.js",
    "cordis.patch.yml",
    "README.md",
    "README.zh-CN.md",
    "check.js",
    "tools/",
    "LICENSE"
  ],
  "scripts": {
    "check": "node check.js"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kalifun/dsh-cwl.git"
  },
  "homepage": "https://github.com/kalifun/dsh-cwl",
  "bugs": {
    "url": "https://github.com/kalifun/dsh-cwl/issues"
  },
  "dependencies": {
    "@deepseek-ai/dsh-tools": "^0.1.2-alpha.2"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-compaction": "^0.1.2-alpha.2",
    "@deepseek-ai/dsh-token-meter": "^0.1.2-alpha.2"
  },
  "license": "MIT",
  "keywords": [
    "deepseek-harness",
